/// Calendário dinâmico: cobre do 1º de janeiro do ano da primeira venda/meta até 31/12 do ano da última. Marcado como tabela de datas.
table d_Calendario
	lineageTag: 5d49357c-edae-45a9-aee2-4550f4eeb66f
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 05189e79-6362-48d6-8235-55356260e866
		summarizeBy: none
		isNameInferred
		sourceColumn: [Data]

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 009abb29-c445-4357-b68c-5e005d7b6498
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano]

	column Trimestre
		dataType: string
		lineageTag: e6a98fc4-a777-43b0-8046-19fd265d17b8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre]
		sortByColumn: Trimestre_Num

	column Trimestre_Num
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 16255576-41b1-4507-80bc-498c4896ea5f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre_Num]

	column Ano_Trimestre
		dataType: string
		lineageTag: d9b8489d-863f-45b0-98d9-9c449fdf7187
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano_Trimestre]
		sortByColumn: AnoTrimestre_Num

	column AnoTrimestre_Num
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 96976b9c-4366-47b2-9c78-05a9ada81783
		summarizeBy: none
		isNameInferred
		sourceColumn: [AnoTrimestre_Num]

	column Mes_Num
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 890b1ac8-f92b-4004-bd1b-834cb5668d18
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes_Num]

	column Mes_Nome
		dataType: string
		lineageTag: 20b29b19-dfe8-4861-a36c-e9e3cb19e8fe
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes_Nome]
		sortByColumn: Mes_Num

	column Mes_Abrev
		dataType: string
		lineageTag: ec78bcd8-a520-4ad4-a0af-c83e1ded6e48
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes_Abrev]
		sortByColumn: Mes_Num

	column Mes_Ano
		dataType: string
		lineageTag: e93750fa-40d0-44c7-94d4-639821459b36
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes_Ano]
		sortByColumn: AnoMes_Num

	column AnoMes_Num
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fa725b37-09e5-4c17-a17f-ec052748028d
		summarizeBy: none
		isNameInferred
		sourceColumn: [AnoMes_Num]

	column Dia
		dataType: int64
		formatString: 0
		lineageTag: f69296ce-eb56-41be-8d30-43ad9fc17687
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia]

	column Dia_Semana_Num
		dataType: int64
		isHidden
		formatString: 0
