		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia_Semana_Num]

	column Dia_Semana_Nome
		dataType: string
		lineageTag: 3f003e88-0f50-430f-b0ef-f1e807a3e0a4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia_Semana_Nome]
		sortByColumn: Dia_Semana_Num

	column Flag_Dia_Util
		dataType: boolean
		lineageTag: 45825673-68da-4228-a0eb-aada5d65f3e9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Flag_Dia_Util]

	column Tipo_Dia
		dataType: string
		lineageTag: bd257c34-f79d-478f-8217-6d4971a94994
		summarizeBy: none
		isNameInferred
		sourceColumn: [Tipo_Dia]

	column Inicio_Mes
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy
		lineageTag: c3fe69f8-6357-4814-a587-075ff8b5f77c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Inicio_Mes]

	hierarchy 'Ano > Trimestre > Mês > Dia'
		lineageTag: 8050a0eb-0531-46a4-afdb-db60ca9a257a

		level Ano
			lineageTag: b30f5300-d19c-4100-8bf3-133fd4d7018b
			column: Ano

		level Trimestre
			lineageTag: b943c158-ee8c-4a39-87fb-1d243020ba27
			column: Trimestre

		level Mês
			lineageTag: 01af0b7f-057c-4301-acbb-5e00d8a181ec
			column: Mes_Nome

		level Dia
			lineageTag: 5c68c169-a846-4d5b-9ab9-388180cd7217
			column: Dia

	partition d_Calendario = calculated
		mode: import
		source =
				VAR _dataMinima = MIN ( MIN ( f_Vendas[Data_Venda] ), MIN ( f_Metas[Data_Mes] ) )
				VAR _dataMaxima = MAX ( MAX ( f_Vendas[Data_Venda] ), MAX ( f_Metas[Data_Mes] ) )
				VAR _datas =
					CALENDAR ( DATE ( YEAR ( _dataMinima ), 1, 1 ), DATE ( YEAR ( _dataMaxima ), 12, 31 ) )
				RETURN
					ADDCOLUMNS (
						SELECTCOLUMNS ( _datas, "Data", [Date] ),
						"Ano", YEAR ( [Data] ),
						"Trimestre", "T" & QUARTER ( [Data] ),
						"Trimestre_Num", QUARTER ( [Data] ),
						"Ano_Trimestre", YEAR ( [Data] ) & "-T" & QUARTER ( [Data] ),
						"AnoTrimestre_Num", YEAR ( [Data] ) * 10 + QUARTER ( [Data] ),
						"Mes_Num", MONTH ( [Data] ),
						"Mes_Nome",
							SWITCH (
								MONTH ( [Data] ),
								1, "Janeiro", 2, "Fevereiro", 3, "Março", 4, "Abril",
								5, "Maio", 6, "Junho", 7, "Julho", 8, "Agosto",
								9, "Setembro", 10, "Outubro", 11, "Novembro", 12, "Dezembro"
							),
						"Mes_Abrev", MID ( "JanFevMarAbrMaiJunJulAgoSetOutNovDez", ( MONTH ( [Data] ) - 1 ) * 3 + 1, 3 ),
						"Mes_Ano",
							MID ( "JanFevMarAbrMaiJunJulAgoSetOutNovDez", ( MONTH ( [Data] ) - 1 ) * 3 + 1, 3 )
								& "/" & YEAR ( [Data] ),
						"AnoMes_Num", YEAR ( [Data] ) * 100 + MONTH ( [Data] ),
						"Dia", DAY ( [Data] ),
						"Dia_Semana_Num", WEEKDAY ( [Data], 2 ),
						"Dia_Semana_Nome",
							SWITCH (
								WEEKDAY ( [Data], 2 ),
								1, "Segunda", 2, "Terça", 3, "Quarta", 4, "Quinta",
								5, "Sexta", 6, "Sábado", 7, "Domingo"
							),
						"Flag_Dia_Util", WEEKDAY ( [Data], 2 ) <= 5,
						"Tipo_Dia", IF ( WEEKDAY ( [Data], 2 ) <= 5, "Dia útil", "Fim de semana" ),
						"Inicio_Mes", DATE ( YEAR ( [Data] ), MONTH ( [Data] ), 1 )
					)

